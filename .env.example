# --- RentYourTime environment ---
# Copy to `.env` (or set these in your process manager / systemd unit) and fill in.

# Public base URL of the deployment (used for Stripe redirect URLs).
APP_URL=https://your-domain.com

# --- /api/v1 central API (docs/API_ARCHITECTURE.md) ---
# APP_URL above remains authoritative for Stripe/email redirect URLs.
# These are additive — nothing above this section changed meaning.

# development | production — informational only (logging/error verbosity),
# never gates a security check on its own.
APP_ENV=development
# Same value as APP_URL today; kept as a separate name because the web app
# and the central API are conceptually different consumers, even though
# they currently live in the same Next.js deployment.
APP_BASE_URL=https://your-domain.com
# Base URL iOS/Watch/widgets/Discord bot point at for /api/v1. Dev:
# https://dev.rentyourtime.atlashc.pl/api/v1 — Prod: https://api.rentyourtime.app/api/v1
# (docs/API_ARCHITECTURE.md "Environments"). Read from exactly one place —
# src/lib/http/config.ts — never hardcoded per-file.
API_BASE_URL=http://localhost:3000/api/v1

# Reserved for the future Postgres migration (docs/DATABASE_MIGRATION.md).
# Unused today — better-sqlite3 + DATA_DIR (see further down) remain the
# only active database configuration. Do not set this until that migration
# actually runs.
DATABASE_URL=

# HS256 access-token signing secret (src/lib/crypto/jwt.ts) — generate with
# `openssl rand -hex 32`. Rotating this invalidates every outstanding access
# token immediately (refresh tokens are unaffected — they're random values
# hashed in the `sessions` table, not JWTs).
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=https://api.rentyourtime.app
ACCESS_TOKEN_AUDIENCE=rentyourtime-clients
# 15-60 minutes per §7 of the spec; 900 = 15 minutes.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh-token session lifetime (src/server/auth/sessions.ts).
REFRESH_TOKEN_TTL_DAYS=60

# Comma-separated allowlist of origins allowed to call /api/v1 with
# credentials (web app + admin panel origins). Never "*" — this API carries
# cookies/credentials. See src/lib/http/security.ts.
CORS_ALLOWED_ORIGINS=https://your-domain.com
# Number of reverse-proxy hops (nginx/Caddy/load balancer) that are trusted
# to have appended to X-Forwarded-For. 0 (default) means X-Forwarded-For is
# never trusted at all — see src/lib/http/security.ts's trustedClientIp()
# and docs/PRODUCTION_CHECKLIST.md.
TRUSTED_PROXY_COUNT=1

# Stripe — use sk_test_... and test Price IDs until you go live. Powers
# checkout, webhooks, billing history (docs/BILLING_PORTAL.md), and the
# Customer Portal (POST /api/billing/portal) — no separate secret needed.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Pro plan prices (create two recurring prices in Stripe):
#   monthly ($8.99 / month) and yearly ($89.99 / year).
STRIPE_PRICE_ID_MONTHLY=price_monthly_xxx
STRIPE_PRICE_ID_YEARLY=price_yearly_xxx

# Legacy single-price fallback used for the yearly plan when
# STRIPE_PRICE_ID_YEARLY is not set. Safe to remove once the two above are set.
STRIPE_PRICE_ID=price_xxx

# Kill switch for new regular Pro subscription sign-ups (POST /api/checkout).
# Disabled unless explicitly set to "true". Existing Pro subscribers, the
# Customer Portal, Contributions, and the Founder Program are unaffected.
ENABLE_PRO_CHECKOUT=false

# No separate price id or secret needed for one-time "Support the project"
# contributions (docs/CONTRIBUTIONS.md) — they reuse STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, and APP_URL above, with a dynamically priced
# Checkout Session (price_data) instead of a fixed Stripe Price.

# Optional, development only (docs/CONTRIBUTIONS.md → "Development demo
# mode") — shows realistic accrued-rent + history on the Support the
# project screen for accounts with no real synced ledger yet. Ignored
# whenever NODE_ENV=production, no matter what these are set to, and
# whenever a real accrued_rent_cents exists for the account. Stripe
# Checkout is never mocked: contributing still creates a real Stripe Test
# Mode session using STRIPE_SECRET_KEY above.
ENABLE_SUPPORT_DEMO=true
SUPPORT_DEMO_ACCRUED_RENT_CENTS=2840
SUPPORT_DEMO_CURRENCY=usd

# RentYourTime Founder Program (docs/FOUNDER_PROGRAM.md) — one Stripe Price
# per tier, each a one-time (not recurring) USD price created in the Stripe
# Dashboard. Required for that tier's checkout to work; a tier with no price
# id set returns 503 rather than letting anyone buy an unpriced slot. Seed
# the tiers themselves with `npm run founders:seed` (reads these same vars).
STRIPE_FOUNDER_FIRST_PRICE_ID=price_founder_first_xxx
STRIPE_FOUNDER_GOLD_PRICE_ID=price_founder_gold_xxx
STRIPE_FOUNDER_BLACK_PRICE_ID=price_founder_black_xxx

# Optional: email address notified (via AWS SES, see EMAIL_* below) on each
# new waitlist signup. Leave empty to disable owner emails — the Discord DM
# path (bot/.env's DISCORD_OWNER_ID, not this file) is independent either way.
# See docs/WAITLIST.md.
WAITLIST_NOTIFY_EMAIL=

# Optional: input to the one-time `npm run admin:grant` bootstrap script only
# (scripts/grant-admin.mjs) — never read by any request-handling code, so it
# can never silently grant ADMIN to whoever matches it. See docs/WAITLIST.md
# for both this and the raw-SQL alternative.
ADMIN_ACCOUNT_EMAIL=

# Optional: directory for the SQLite database (defaults to ./.data).
# DATA_DIR=/var/lib/rentyourtime

# DISCORD_OWNER_ID lives in bot/.env.example, not here — it's the bot
# process, not this app, that reads it (DM notifications for new signups).

# Apple App Store subscriptions — scaffolding only, see docs/APPLE_SUBSCRIPTIONS.md.
# Without these, POST /api/subscriptions/apple/sync (and its /api/v1/subscription/apple/*
# equivalents) return 503. With them but without real JWS verification implemented,
# they return 501. Either way it never grants Pro from unverified data.
# Do not put real values in source control.
APPLE_BUNDLE_ID=com.rentyourtime.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Multi-line .p8 private key — quote it and keep literal newlines (or \n
# escapes, matching however your process manager passes multi-line values).
APPLE_PRIVATE_KEY=
# Sandbox | Production — informational until real verification is implemented;
# once it is, the decoded transaction's own environment field is the source of
# truth (never trust this var alone to decide which is which).
APPLE_ENVIRONMENT=Sandbox
APPLE_MONTHLY_PRODUCT_ID=com.rentyourtime.app.pro.monthly
APPLE_ANNUAL_PRODUCT_ID=com.rentyourtime.app.pro.annual

# Email verification + password reset (AWS SES v2) — see
# docs/EMAIL_VERIFICATION.md. (The brief's §24 lists these as SES_REGION /
# SES_FROM_EMAIL — this project already had AWS_REGION / EMAIL_FROM for the
# exact same purpose; reusing them rather than adding a second, unread pair
# of env vars that would silently do nothing.)
AWS_REGION=eu-central-1
# Optional: leave both empty on EC2/ECS with an IAM role attached — the AWS
# SDK's default credential provider chain picks it up automatically. Only
# set these for local development or hosts without an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=RentYourTime <no-reply-test@dev.rentyourtime.atlashc.pl>
# Optional.
EMAIL_REPLY_TO=
